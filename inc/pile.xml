<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Include [
<!ENTITY % scale_entities SYSTEM "scale_entities.ent">
%scale_entities;
]>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
       * https://wiki.openstreetmap.org/wiki/Tag:seamark:type%3pile
  -->

  <Style name="pile">
    <Rule>
      &maxscale_zoom14;
      <Filter>[category]="pile"</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/mooring/pile.svg" transform="scale(0.2)" />
    </Rule>
  </Style>

  <Layer name="pile" status="on" srs="epsg:3857">
    <StyleName>pile</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT way
           FROM planet_osm_point
          WHERE tags->'seamark:type' = 'pile'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
