<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Include [
<!ENTITY % scale_entities SYSTEM "scale_entities.ent">
%scale_entities;
]>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
       * https://wiki.openstreetmap.org/wiki/Tag:seamark:type=separation_boundary
  -->

  <Style name="xxx">
    <Rule>
      <LineSymbolizer stroke="magenta" stroke-width="1" stroke-dasharray="10,10" stroke-opacity="0.5"/>
    </Rule>
  </Style>

  <Layer name="xxx" status="on" srs="epsg:3857">
    <StyleName>xxx</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT way
           FROM planet_osm_line
          WHERE tags->'seamark:type' = 'separation_boundary'
         UNION
         SELECT way
           FROM planet_osm_polygon
          WHERE tags->'seamark:type' = 'separation_boundary'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
