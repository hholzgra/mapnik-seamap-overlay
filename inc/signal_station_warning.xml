<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Include [
<!ENTITY % scale_entities SYSTEM "scale_entities.ent">
%scale_entities;
]>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
       * https://wiki.openstreetmap.org/wiki/Tag:seamark:type=signal_station_warning
  -->

  <Style name="signal_station_warning">
    <Rule>
      &maxscale_zoom14;
      <MarkersSymbolizer allow-overlap="true" file="symbols/signal_station_warning/signal_station_warning.svg"/>
      <TextSymbolizer dy="-8" fontset-name='regular'>[label]</TextSymbolizer>
    </Rule>
  </Style>

  <Layer name="signal_station_warning" status="on" srs="epsg:3857">
    <StyleName>signal_station_warning</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (
         SELECT way
           FROM planet_osm_point
          WHERE tags->'seamark:type' = 'signal_station_warning'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
