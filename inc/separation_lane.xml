<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Include [
<!ENTITY % scale_entities SYSTEM "scale_entities.ent">
%scale_entities;
]>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
       * https://wiki.openstreetmap.org/wiki/Tag:seamark:type=separation_lane
  -->

  <Style name="separation_line">
    <Rule>
      <MarkersSymbolizer placement="line" file="symbols/separation/lane_arrow.svg" transform="rotate(90) scale(0.5)"/>
    </Rule>
  </Style>

  <Layer name="separation_line" status="on" srs="epsg:3857">
    <StyleName>separation_line</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT way
           FROM planet_osm_line
          WHERE tags->'seamark:type' = 'separation_lane'
         UNION
         SELECT way
           FROM planet_osm_polygon
          WHERE tags->'seamark:type' = 'separation_lane'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
