<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Include [
<!ENTITY % scale_entities SYSTEM "scale_entities.ent">
%scale_entities;
]>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
    * https://wiki.openstreetmap.org/wiki/Tag:seamark:type%3Dsmall_craft_facility
    * https://wiki.openstreetmap.org/wiki/Key:seamark:small_craft_facility:category
  -->

  <Style name="small_craft_facility">
    <Rule>
      &maxscale_zoom14;
      <Filter>[category] = 'visitor_berth'</Filter>
      <MarkersSymbolizer file='symbols/small_craft_facility/visitor_berth.svg' transform='scale(0.5)'/>
    </Rule>
    <Rule>
      &maxscale_zoom14;
      <Filter>[category] = 'nautical_club'</Filter>
      <MarkersSymbolizer file='symbols/small_craft_facility/nautical_club.svg' transform='scale(0.5)'/>
    </Rule>
    <Rule>
      &maxscale_zoom14;
      <Filter>[category] = 'boat_hoist'</Filter>
      <MarkersSymbolizer file='symbols/small_craft_facility/boat_hoist.svg' transform='scale(0.5)'/>
    </Rule>
    <Rule>
      &maxscale_zoom14;
      <Filter>[category] = 'boatyard'</Filter>
      <MarkersSymbolizer file='symbols/small_craft_facility/boatyard.svg' transform='scale(0.5)'/>
    </Rule>
    <Rule>
      &maxscale_zoom14;
      <Filter>[category] = 'chandler'</Filter>
      <MarkersSymbolizer file='symbols/small_craft_facility/chandler.svg' transform='scale(0.5)'/>
    </Rule>
    <Rule>
      &maxscale_zoom14;
      <Filter>[category] = 'fuel_station'</Filter>
      <MarkersSymbolizer file='symbols/small_craft_facility/fuel_station.svg' transform='scale(0.5)'/>
    </Rule>
    <Rule>
      &maxscale_zoom14;
      <Filter>[category] = 'showers'</Filter>
      <MarkersSymbolizer file='symbols/small_craft_facility/showers.svg' transform='scale(0.5)'/>
    </Rule>
    <Rule>
      &maxscale_zoom14;
      <Filter>[category] = 'launderette'</Filter>
      <MarkersSymbolizer file='symbols/small_craft_facility/launderette.svg' transform='scale(0.5)'/>
      <Rule>
        &maxscale_zoom14;
        <Filter>[category] = 'toilets'</Filter>
        <MarkersSymbolizer file='symbols/small_craft_facility/toilets.svg' transform='scale(0.5)'/>
      </Rule>
    </Rule>
    <Rule>
      &maxscale_zoom14;
      <Filter>[category] = 'pump_out'</Filter>
      <MarkersSymbolizer file='symbols/small_craft_facility/pump_out.svg' transform='scale(0.5)'/>
    </Rule>
    <Rule>
      &maxscale_zoom14;
      <Filter>[category] = 'slipway'</Filter>
      <MarkersSymbolizer file='symbols/small_craft_facility/slipway.svg' transform='scale(0.5)'/>
    </Rule>
    <Rule>
      &maxscale_zoom14;
      <Filter>[category] = 'visitor_mooring'</Filter>
      <MarkersSymbolizer file='symbols/small_craft_facility/visitor_mooring.svg' transform='scale(0.5)'/>
    </Rule>
  </Style>

  <Layer name="small_craft_facility" status="on" srs="epsg:3857">
    <StyleName>small_craft_facility</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT way
              , tags->'seamark:small_craft_facility:category' as category
           FROM planet_osm_point
          WHERE tags->'seamark:type' = 'small_craft_facility'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
