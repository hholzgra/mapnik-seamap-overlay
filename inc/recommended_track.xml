<?xml version="1.0" encoding="utf-8"?>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
       * https://wiki.openstreetmap.org/wiki/Tag:seamark:type%3Drecommended_track
  -->

  <!-- TODO: ° rendering with superscript underline, as in OpenSeaMap -->
  <!-- TODO: are orientation values always numeric degrees? -->

  <Style name="recommended_track">
    <Rule>
      <LineSymbolizer stroke-width="1" stroke="black"/>
      <TextSymbolizer fontset-name="regular" allow-overlap="true" dy="-5" placement="line">[label]</TextSymbolizer>
    </Rule>
  </Style>

  <Layer name="recommended_track" status="on" srs="epsg:3857">
    <StyleName>recommended_track</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT way
              , CONCAT(tags->'seamark:navigation_line:recommended_track','°') as label
           FROM planet_osm_line
          WHERE tags->'seamark:type' = 'recommended_track'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
