<?xml version="1.0" encoding="utf-8"?>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
       * https://wiki.openstreetmap.org/wiki/Seamarks/Anchorages
  -->

  <!-- TODO: add anchor_berge -->

  <Style name="anchorage_point">
    <Rule>
      <MarkersSymbolizer allow-overlap="true" file="symbols/anchorage/anchorage.svg" multi-policy="each" width="10" height="10"  transform="rotate(180)" />
      <TextSymbolizer allow-overlap="true" face-name="DejaVu Sans Book" fill="magenta" text_size="8" dx="+10" multi-policy="each">[name]</TextSymbolizer>
    </Rule>
  </Style>

  <Layer name="anchorage_point" status="on" srs="epsg:3857">
    <StyleName>anchorage_point</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (
         SELECT way
              , tags->'seamark:name'  as name
           FROM planet_osm_point
          WHERE tags->'seamark:type' = 'anchorage'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

  <Style name="anchorage_area">
    <Rule>
      <MarkersSymbolizer allow-overlap="true" file="symbols/anchorage/anchorage.svg" placement="line" spacing="100" transform="scale(0.2)"/>
      <MarkersSymbolizer allow-overlap="false" file="symbols/anchorage/restricted.svg" placement="line" spacing="10" transform="scale(0.5) rotate(180)"/>
      <MarkersSymbolizer allow-overlap="true" file="symbols/anchorage/anchorage.svg" multi-policy="each" width="10" height="10"  transform="rotate(180)" />
      <TextSymbolizer allow-overlap="true" face-name="DejaVu Sans Book" fill="magenta" text_size="8" dx="+10" multi-policy="each">[name]</TextSymbolizer>
    </Rule>
  </Style>

  <Layer name="anchorage_area" status="on" srs="epsg:3857">
    <StyleName>anchorage_area</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT ST_MakePolygon(way) as way
              , tags->'seamark:name'  as name
           FROM planet_osm_line
          WHERE tags->'seamark:type' = 'anchorage'
         UNION
         SELECT way
              , tags->'seamark:name'  as name
           FROM planet_osm_polygon
          WHERE tags->'seamark:type' = 'anchorage'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
