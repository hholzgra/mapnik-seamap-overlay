<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Include [
<!ENTITY % scale_entities SYSTEM "scale_entities.ent">
%scale_entities;
]>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
       * https://wiki.openstreetmap.org/wiki/Tag:seamark:type%3Dmooring
  -->

  <!-- TODO: ... -->

  <Style name="...">
    <Rule>
      &maxscale-zoom14;
      <Filter>[category]="dolphin"</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/mooring/dolphin.svg" transform="scale(0.2)" />
    </Rule>
    <Rule>
      &maxscale-zoom14;
      <Filter>[category]="deviated_dolphin"</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/mooring/deviated_dolphin.svg" transform="scale(0.4)" />
    </Rule>
    <Rule>
      &maxscale-zoom14;
      <Filter>[category]="buoy"</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/mooring/mooring.svg" transform="scale(0.4)" />
    </Rule>
    <Rule>
      &maxscale-zoom14;
      <Filter>[category]="pile"</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/mooring/pile.svg" transform="scale(0.2)" />
    </Rule>
    <Rule>
      &maxscale-zoom14;
      <Filter>[category]="post"</Filter>
      <Filter>[category]="bollard"</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/mooring/post.svg" transform="scale(0.2)" />
    </Rule>
  </Style>

  <Layer name="..." status="on" srs="epsg:3857">
    <StyleName>...</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT way
              , tags->'seamark:mooring:category' as category
              , tags->'seamark:mooring:shape'    as shape
           FROM planet_osm_point
          WHERE tags->'seamark:type' = 'mooring'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
