<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Include [
<!ENTITY % scale_entities SYSTEM "scale_entities.ent">
%scale_entities;
]>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
       * ...
  -->

  <!-- TODO: ... -->

  <Style name="seamark_light">
    <Rule>
      <MarkersSymbolizer allow-overlap="true" file="symbols/light/light.svg" fill="[colour]" transform="translate(15.5,10) rotate(120) scale(0.3)"/>
    </Rule>
    <Rule>
      &maxscale_zoom13;
      <Filter>[has_sector] = 0 and [label] != ''</Filter>
      <TextSymbolizer fontset-name="regular" size="8"
                      dx="9" horizontal-alignment="right" allow-overlap="true"
                      >[label]</TextSymbolizer>
    </Rule>
    <Rule>
      &maxscale_zoom15;
      <Filter>[has_sector] = 1 and [label] != ''</Filter>
      <TextSymbolizer fontset-name="regular" size="8"
                      dx="9" horizontal-alignment="right" justify-alignment="left"
                      allow-overlap="true"
                      >[label]</TextSymbolizer>
    </Rule>
  </Style>

  <Style name="seamark_light_marker">
    <Rule>
      <Filter>[light_type] = 'light_minor'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/light/minor.svg" transform="scale(0.5)"/>
    </Rule>
    <Rule>
      <!-- landmarks without category and with no or light function are
           rendered as major lights, like OpenSeaMap / JOSM SeaChart does -->
      <Filter>[light_type] = 'light_major'
              or ([light_type] = 'landmark' and [landmark_category] = ''
                  and ([landmark_function] = '' or [landmark_function].match('(.*;)?light(;.*)?')))</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/light/major.svg" transform="scale(0.8)"/>
      <TextSymbolizer fontset-name="bold" size="10" fill="#333333"
                      allow-overlap="true" horizontal-alignment="right" dy="-10">[name]</TextSymbolizer>
    </Rule>
  </Style>

  <Layer name="seamark_light" status="on" srs="epsg:3857">
    <StyleName>seamark_light</StyleName>
    <StyleName>seamark_light_marker</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT way
              , tags->'seamark:type' AS light_type
              , COALESCE(tags->'seamark:landmark:category', '') AS landmark_category
              , COALESCE(tags->'seamark:landmark:function', '') AS landmark_function
              , seamark_light_flare_colour(tags) AS colour
              , COALESCE(seamark_light_characteristics(tags), '') AS label
              , seamark_has_light_sector(tags)::int AS has_sector
              , tags->'seamark:name' as name
           FROM planet_osm_point
          WHERE seamark_has_light(tags)
       ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

  <Style name="seamark_light_sector">
    <Rule>
      &maxscale_zoom13;
      <ArcSymbolizer radius="100" start-angle="[sector_start]" end-angle="[sector_end]"
                     stroke="[colour]" stroke-width="2" stroke-opacity="0.9"
                     radius-stroke="dimgray" radius-stroke-width="0.5"
                     radius-stroke-dasharray="6,4"
                     text="[label]" text-face-name="DejaVu Sans Book" text-size="9"
                     text-fill="#333333" text-halo-fill="#ffffff" text-halo-radius="1.5" text-offset="4"/>
    </Rule>
  </Style>

  <Layer name="seamark_light_sector" status="on" srs="epsg:3857">
    <StyleName>seamark_light_sector</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT p.way,
                s.colour,
                s.sector_start,
                s.sector_end,
                COALESCE(s.label, '') AS label
           FROM planet_osm_point p
          CROSS JOIN LATERAL seamark_light_sectors(p.tags) s
          WHERE seamark_has_light_sector(p.tags)
       ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
