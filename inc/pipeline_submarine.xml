<?xml version="1.0" encoding="utf-8"?>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
       * https://wiki.openstreetmap.org/wiki/Tag:seamark:type%3Dpipeline_submarine
  -->


  <Style name="pipeline_submarine">
    <Rule>
      <MarkersSymbolizer allow-overlap="true" file="symbols/pipeline/pipeline.svg" placement="line" spacing="30" transform="rotate(90)"/>
    </Rule>
  </Style>

  <Layer name="pipeline_submarine" status="on" srs="epsg:3857">
    <StyleName>pipeline_submarine</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT way
           FROM planet_osm_line
          WHERE tags->'seamark:type' = 'pipeline_submarine'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
