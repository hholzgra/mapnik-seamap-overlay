  <Layer name="notice" status="on" srs="epsg:3857">
    <StyleName>notice</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT way
              , tags->'seamark:notice:category' AS category
           FROM planet_osm_point
          WHERE tags->'seamark:type' = 'notice'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

