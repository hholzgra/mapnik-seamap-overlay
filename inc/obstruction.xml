<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Include [
<!ENTITY % scale_entities SYSTEM "scale_entities.ent">
%scale_entities;
]>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
       * https://wiki.openstreetmap.org/wiki/Tag:seamark:type%3obstruction
  -->

  <Style name="obstruction">
    <Rule>
      &maxscale_zoom14;
	    <TextSymbolizer font-set="regular" size="16">#</TextSymbolizer> 
    </Rule>
  </Style>

  <Layer name="obstruction" status="on" srs="epsg:3857">
    <StyleName>obstruction</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT way
           FROM planet_osm_point
	  WHERE tags->'seamark:type' = 'obstruction'
         UNION
	 SELECT ST_MakePolygon(way) as way
	   FROM planet_osm_line
	   WHERE ST_IsClosed(way)
	     AND tags->'seamark:type' = 'obstruction'
	  UNION
	  SELECT way
	    FROM planet_osm_polygon
	     AND tags->'seamark:type' = 'obstruction'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
