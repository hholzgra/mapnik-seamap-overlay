<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Include [
<!ENTITY % scale_entities SYSTEM "scale_entities.ent">
%scale_entities;
]>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
       * https://wiki.openstreetmap.org/wiki/Tag:seamark:type=landmark
       * https://wiki.openstreetmap.org/wiki/Key:seamark:landmark:category
       * https://wiki.openstreetmap.org/wiki/Key:seamark:landmark:function
  -->

  <!-- TODO: some symbols still missing -->

  <!-- TODO: not all landmarks are mere points, lines and polygons need to be handled, too -->

  <Style name="landmark">
    <Rule>
      &maxscale_zoom12;
      <Filter>[category]='mast'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/mast.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[category]='chimney'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/chimney.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[category]='tower' or [category]='radar_scanner'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/tower.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[category]='column' or [category]='monument' or [category]='monument' or [category]='obelisk' or [category]='statue'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/monument.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[category]='cross'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/cross.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[category]='windsack'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/Windsock.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[category]='windmotor'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/wind-motor.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[category]='windmill'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/Windmill.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[category]='dish_aerial'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/dish.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[category]='flagstaff'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/flagstaff.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[category]='flare_stack'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/flarestack.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[function]='church' or [function]='chappel'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/church.svg" transform="scale(4) translate(0,-8)"/>
      <!-- TODO: there are different categories of churches with slightly different symbols -->
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[function]='mosque'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/minaret.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
    <Rule>
      &maxscale_zoom12;
      <Filter>[function]='temple' or [function]='buddhist_temple' or [function]='pagoda' or [function]='shinto_shrine'</Filter>
      <MarkersSymbolizer allow-overlap="true" file="symbols/landmark/minaret.svg" transform="scale(4) translate(0,-8)"/>
    </Rule>
  </Style>

  <Layer name="landmark" status="on" srs="epsg:3857">
    <StyleName>landmark</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (SELECT way
              , tags->'seamark:landmark:category' as category
              , tags->'seamark:landmark:function' as function
           FROM planet_osm_point
          WHERE tags->'seamark:type' = 'landmark'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
