<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Include [
<!ENTITY % scale_entities SYSTEM "scale_entities.ent">
%scale_entities;
]>
<Include xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- see also:
       * https://wiki.openstreetmap.org/wiki/Tag:seamark:type=pilot%20boarding
  -->

  <Style name="pilot_boarding">
    <Rule>
      &maxscale_zoom14;
      <MarkersSymbolizer allow-overlap="true" file="symbols/pilot_boarding/pilot_boarding.svg"/>
    </Rule>
    <Rule>
      &maxscale_zoom16;
      <TextSymbolizer allow-overlap="true" fontset-name="regular" size="12" dx="15" dy="-7" fill="#7E0B48">[name]</TextSymbolizer>
    </Rule>
    <Rule>
      &maxscale_zoom14;
      <Filter>[category] = 'helicopter'</Filter>
      <TextSymbolizer allow-overlap="true" fontset-name="regular" size="12" dx="15" dy="7" fill="#7E0B48">"H"</TextSymbolizer>
    </Rule>
  </Style>

  <Layer name="pilot_boarding" status="on" srs="epsg:3857">
    <StyleName>pilot_boarding</StyleName>
    <Datasource base="gis">
      <Parameter name="table">
        (
         SELECT way
              , tags->'seamark:name' AS name
              , tags->'seamark:pilot_boarding:category' AS category
           FROM planet_osm_point
          WHERE tags->'seamark:type' = 'pilot_boarding'
        ) AS way
      </Parameter>
      <Parameter name="geometry_field">way</Parameter>
    </Datasource>
  </Layer>

</Include>
